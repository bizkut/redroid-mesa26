From 7846c0ad0658ae6c7a961103ac6a860e358f3942 Mon Sep 17 00:00:00 2001
From: Hasanuddin Abu Bakar <177014+bizkut@users.noreply.github.com>
Date: Tue, 20 Oct 2026 12:54:44 +0800
Subject: [PATCH] android: link zstd required by Android 14 libelf

---
 android/Android.mk | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/android/Android.mk b/android/Android.mk
index aaddb17..e1c0575 100644
--- a/android/Android.mk
+++ b/android/Android.mk
@@ -55,7 +55,7 @@ MESA_VK_LIB_SUFFIX_swrast := lvp
 include $(CLEAR_VARS)
 
 LOCAL_SHARED_LIBRARIES := libc libdl libdrm libm liblog libcutils libz libc++ libnativewindow libsync libhardware
-LOCAL_STATIC_LIBRARIES := libexpat libarect libelf
+LOCAL_STATIC_LIBRARIES := libexpat libarect libelf libzstd
 LOCAL_HEADER_LIBRARIES := libnativebase_headers hwvulkan_headers
 MESON_GEN_PKGCONFIGS := log cutils expat hardware libdrm:$(LIBDRM_VERSION) nativewindow sync zlib:1.2.11 libelf
 LOCAL_CFLAGS += $(BOARD_MESA3D_CFLAGS)
@@ -124,7 +124,6 @@ LOCAL_SHARED_LIBRARIES += \
     libutils
 ifeq ($(shell test $(PLATFORM_SDK_VERSION) -ge 35; echo $$?), 0)
 LOCAL_SHARED_LIBRARIES += libui
-LOCAL_STATIC_LIBRARIES += libzstd
 MESON_GEN_PKGCONFIGS += ui
 endif
 MESON_GEN_PKGCONFIGS += android.hardware.graphics.mapper:4.0
-- 
2.53.0

